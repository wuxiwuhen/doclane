# ===== 目标栈（Vercel + Supabase + Daytona）=====

# --- Supabase（项目 dashboard → Settings → API）---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Daytona（沙箱计算，仅服务端）---
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api

# --- 语义检索（可选；不配则仅关键词检索）---
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# --- 管理（注册时判定 admin 角色，逗号分隔）---
ADMIN_EMAILS=

# ===== 迁移期：旧本地模式（server.js 仍在用，P5 退役）=====
REGION=us
SANDBOX_CPU=2
SANDBOX_MEMORY_GB=4
SANDBOX_DISK_GB=10
AUTO_STOP_MINUTES=60
TTL_MINUTES=10080
WARM_UP=true
