# ===== 目标栈（Vercel + Supabase + Daytona）=====

# --- Supabase（项目 dashboard → Settings → API）---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Daytona（沙箱计算，仅服务端；注意大小写 DAYTONA_API_Key）---
DAYTONA_API_Key=
DAYTONA_API_URL=https://app.daytona.io/api

# --- 多用户沙箱（每用户独立沙箱，用完即毁）---
# 任务结束回调地址（drain.py 用于释放沙箱）；release 接口鉴权 secret
APP_URL=
RELEASE_SECRET=
# 单文件大小上限（MB）
MAX_UPLOAD_MB=10
# 单任务总时长上限（分钟，drain.py 内全局超时）
JOB_TIMEOUT_MIN=30
# 沙箱寿命上限（分钟，Daytona 侧硬兜底，防额度跑空）
SANDBOX_TTL_MIN=180
# 空闲自动停机（分钟，兜底回收，停机后磁盘保留可唤醒）
AUTO_STOP_MINUTES=60

# --- 沙箱规格（ensure.js 使用，可选，均有默认值）---
SNAPSHOT_NAME=mineru-snap-baked
SANDBOX_NAME=mineru-extractor-sandbox
REGION=us
SANDBOX_CLASS=container
SANDBOX_CPU=2
SANDBOX_MEMORY_GB=4
SANDBOX_DISK_GB=10

# --- 纯本地模式（可选；只用 Daytona key，数据存本机 SQLite + data/）---
# DATA_BACKEND=local
# LOCAL_USER_ID=local-user
# LOCAL_USER_EMAIL=local@doclane.local
# LOCAL_USER_NAME=Local Admin
