{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "builds": [
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "api/entry.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/entry.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
